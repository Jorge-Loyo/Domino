{
    "buildCommand": "echo done",
    "outputDirectory": ".",
    "routes": [
        { "handle": "filesystem" },
        { "src": "/login", "dest": "/login.html" },
        { "src": "/registro", "dest": "/registro.html" },
        { "src": "/(.*)", "dest": "/index.html" }
    ],
    "headers": [
        {
            "source": "/sw.js",
            "headers": [
                { "key": "Cache-Control", "value": "no-cache" },
                { "key": "Service-Worker-Allowed", "value": "/" }
            ]
        }
    ]
}
